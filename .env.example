# ==============================================================================
# ARADHANA INTERIOR — Environment Configuration
# Copy this file to `.env.local` for local testing or configure in Vercel.
# NEVER commit `.env`, `.env.local`, or secret credentials to Git.
# ==============================================================================

# 1. Production site base URL (no trailing slash). Used for canonical & Open Graph URLs.
# Leave blank during preview to use the active browser origin automatically.
VITE_SITE_URL=

# 2. Public studio phone number displayed on Contact & Footer (placeholder if unset).
VITE_CONTACT_PHONE=

# 3. Official WhatsApp Business number with country code (e.g., 9198XXXXXXXX).
# Leave blank in demo mode to keep WhatsApp quick-chat disabled.
VITE_WHATSAPP_NUMBER=

# 4. Public studio enquiry email address (placeholder if unset).
VITE_CONTACT_EMAIL=

# 5. Studio street/city address in Tamil Nadu (placeholder if unset).
VITE_STUDIO_ADDRESS=

# 6. Formspree (or compatible JSON POST) enquiry endpoint URL.
# Leave blank in demo mode to run local validation without false delivery claims.
VITE_FORMSPREE_ENDPOINT=
